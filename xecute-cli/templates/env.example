# Optional secrets only. Copy to .env when credentials are needed.
# Process variables from your deployment/secret store take precedence.
# .env is ignored by Git and Docker. Never commit real credentials.
# Normal settings belong in AppConfig.toml.

# DATABASE_URL=postgres://user:password@localhost/app
# JWT_SECRET=replace-with-a-strong-secret
# SENTRY_DSN=your-private-dsn
