{
  "name": "xecute-docs",
  "version": "0.0.0",
  "description": "Xecute architecture tools and runtime documentation",
  "private": true,
  "type": "module",
  "keywords": [
    "react",
    "vite",
    "fumadocs",
    "documentation",
    "tailwind-css"
  ],
  "scripts": {
    "build": "bun run check:docs && tsc -p tsconfig.app.json && vite build && cp dist/index.html dist/404.html && node scripts/generate-sitemap.mjs",
    "dev": "bun run sync:content && vite --port 3002 --strictPort",
    "preview": "vite preview",
    "check-types": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "sync:content": "node scripts/sync-content.mjs",
    "check:docs": "node scripts/sync-content.mjs --check && node scripts/check-docs.mjs",
    "check:render": "node scripts/render-docs.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.4.1",
    "fumadocs-mdx": "14.2.3",
    "fumadocs-ui": "16.4.1",
    "lucide-react": "^0.562.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.1"
  }
}
